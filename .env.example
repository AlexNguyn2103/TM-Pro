# =============================================
# NEON TEAMWORK — Environment Variables
# =============================================
# Copy file này thành .env và điền các giá trị

# PostgreSQL connection string
# Lấy từ Render > PostgreSQL > Connection String (External)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session secret — đặt một chuỗi bí mật ngẫu nhiên dài
SESSION_SECRET=your_super_secret_key_here_change_this_123456

# Môi trường
NODE_ENV=production

# Port (Render tự set, không cần đổi)
PORT=3000
