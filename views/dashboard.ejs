<%- include('partials/header') %>
<%- include('partials/navbar', {notifications, unreadCount}) %>

<div class="container" style="padding-top:1rem;padding-bottom:2rem">
  <% if (flash) { %><div class="flash flash-<%= flashType %>"><%= flash === 'success' ? '✅' : '⚠️' %> <%= flash %></div><% } %>

  <!-- Header -->
  <div class="d-flex align-center justify-between flex-wrap mb-4" style="gap:1rem">
    <div>
      <h1 style="color:var(--primary-dark);margin-bottom:0.3rem;font-size:1.6rem;letter-spacing:-0.02em">
        Xin chào, <span style="color:var(--primary)"><%= currentUser.displayName %></span> 👋
      </h1>
      <p class="text-dim">Chào mừng trở lại! Dưới đây là tổng quan công việc của bạn.</p>
    </div>
    <div style="display:flex;gap:0.6rem">
      <a href="/projects/new" class="btn btn-primary">✨ Tạo dự án</a>
      <a href="/projects/join" class="btn btn-ghost" style="border-color:var(--primary)">🔗 Tham gia</a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="stats-grid mb-4">
    <div class="stat-card s-green">
      <div class="stat-number"><%= myProjects.length %></div>
      <div class="stat-label">Dự án tham gia</div>
    </div>
    <div class="stat-card s-brown">
      <div class="stat-number"><%= pendingTasks.length %></div>
      <div class="stat-label">Nhiệm vụ đang làm</div>
    </div>
    <div class="stat-card s-yellow">
      <div class="stat-number"><%= deadlineWarnings.length %></div>
      <div class="stat-label">Nhiệm vụ đến hạn</div>
    </div>
    <div class="stat-card s-pink">
      <div class="stat-number"><%= unreadCount %></div>
      <div class="stat-label">Thông báo mới</div>
    </div>
  </div>

  <div class="dashboard-grid">
    <!-- Left column: Projects and Tasks -->
    <div>
      <!-- Deadline warnings -->
      <% if (deadlineWarnings.length > 0) { %>
        <div class="card card-glow-pink mb-4" style="border-color:rgba(239,68,68,0.3)">
          <div class="card-header" style="margin-bottom:0.8rem;border-bottom-color:rgba(239,68,68,0.1)">
            <span class="card-title" style="color:var(--red);font-size:0.95rem">⚠️ CẦN CHÚ Ý: SẮP ĐẾN HẠN</span>
          </div>
          <% deadlineWarnings.forEach(t => { %>
            <div style="display:flex;align-items:center;gap:0.8rem;padding:0.6rem 0;border-bottom:1px solid rgba(239,68,68,0.06)">
              <div style="background:rgba(239,68,68,0.1);width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0">⏰</div>
              <div style="flex:1">
                <div style="font-weight:600;color:var(--text-bright);font-size:0.9rem;margin-bottom:2px"><%= t.title %></div>
                <div style="font-size:0.75rem;color:var(--text-dim)">📁 <%= t.project_name %></div>
              </div>
              <div style="font-size:0.8rem;font-weight:600;color:var(--red)" data-deadline="<%= t.deadline %>"></div>
              <a href="/projects/<%= t.project_id %>?tab=tasks" class="btn btn-red btn-sm">Xem ngay</a>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- My Projects -->
      <h2 style="font-size:1rem;color:var(--primary-dark);letter-spacing:0.05em;margin-bottom:1rem;text-transform:uppercase;font-weight:700">
        📁 Dự án của tôi
      </h2>
      <% if (myProjects.length === 0) { %>
        <div class="empty-state card mb-4">
          <div class="empty-state-icon">🚀</div>
          <p style="font-size:0.95rem;color:var(--text-dim);margin-bottom:1rem">Bạn chưa tham gia dự án nào</p>
          <a href="/projects/new" class="btn btn-primary">Tạo dự án đầu tiên</a>
        </div>
      <% } else { %>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.2rem;margin-bottom:2rem">
          <% myProjects.forEach(p => {
            const progress = p.task_count > 0 ? Math.round((p.done_count / p.task_count) * 100) : 0;
            const isOverdue = p.deadline && new Date(p.deadline) < new Date() && p.status !== 'completed';
            const roleLabel = {leader:'👑 Trưởng nhóm',vice_leader:'⭐ Phó nhóm',member:'👤 Thành viên',custom:`🎯 ${p.custom_role_name||''}`}[p.role] || p.role;
          %>
            <a href="/projects/<%= p.id %>" class="project-card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.5rem">
                <div style="font-size:1.05rem;color:var(--text-bright);font-weight:700;line-height:1.2;margin-right:8px"><%= p.name %></div>
                <% if (p.status === 'completed') { %>
                  <span class="badge badge-green">✅ Hoàn thành</span>
                <% } else if (isOverdue) { %>
                  <span class="badge badge-red">⚠️ Trễ hạn</span>
                <% } else { %>
                  <span class="badge badge-brown">🟢 Đang chạy</span>
                <% } %>
              </div>
              
              <% if (p.description) { %>
                <p style="font-size:0.82rem;color:var(--text-dim);line-height:1.5;margin-bottom:1rem"><%= p.description.substring(0,90) %><%= p.description.length>90?'...':'' %></p>
              <% } %>
              
              <!-- Progress -->
              <div style="margin-bottom:0.8rem">
                <div style="display:flex;justify-content:space-between;font-size:0.75rem;margin-bottom:5px">
                  <span class="text-dim">Tiến độ công việc</span>
                  <span style="color:var(--primary-dark);font-weight:600"><%= progress %>%</span>
                </div>
                <div class="progress-wrap"><div class="progress-fill" data-pct="<%= progress %>" style="width:0"></div></div>
              </div>
              
              <div class="project-card-meta mb-3">
                <span style="display:flex;align-items:center;gap:4px">👥 <%= p.member_count %></span>
                <span style="display:flex;align-items:center;gap:4px">📋 <%= p.done_count %>/<%= p.task_count %> xong</span>
                <% if (p.deadline) { %><span style="display:flex;align-items:center;gap:4px">📅 <%= new Date(p.deadline).toLocaleDateString('vi-VN') %></span><% } %>
              </div>
              
              <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--card-border);padding-top:0.8rem">
                <span class="badge <%= {leader:'badge-green',vice_leader:'badge-brown',member:'badge-dim',custom:'badge-pink'}[p.role]||'badge-dim' %>"><%= roleLabel %></span>
                <span style="font-size:0.75rem;color:var(--text-dim);font-weight:600">Điểm: <span style="color:var(--gold)"><%= p.score||0 %></span></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>

      <!-- My pending tasks -->
      <% if (pendingTasks.length > 0) { %>
        <h2 style="font-size:1rem;color:var(--primary-dark);letter-spacing:0.05em;margin:2rem 0 1rem;text-transform:uppercase;font-weight:700">
          📋 Nhiệm vụ cần làm
        </h2>
        <div style="display:grid;gap:0.6rem">
          <% pendingTasks.forEach(t => { %>
            <div class="task-card priority-<%= t.priority %>" style="margin-bottom:0">
              <div class="task-card-header" style="margin-bottom:0.3rem">
                <div class="task-title-text" style="font-size:0.95rem"><%= t.title %></div>
                <div class="task-badges">
                  <span class="badge <%= {urgent:'badge-red',high:'badge-pink',medium:'badge-yellow',low:'badge-dim'}[t.priority] %>">
                    <%= {urgent:'🔴 Khẩn',high:'🟠 Cao',medium:'🟡 TB',low:'⚪ Thấp'}[t.priority] %>
                  </span>
                  <a href="/projects/<%= t.project_id %>?tab=tasks" class="btn btn-ghost btn-xs" style="padding:2px 8px">Xem chi tiết</a>
                </div>
              </div>
              <div class="task-meta-row" style="margin-bottom:0;font-size:0.8rem">
                <div class="task-meta-item">📁 <%= t.project_name %></div>
                <% if (t.deadline) { %><div class="task-meta-item">· <span data-deadline="<%= t.deadline %>"></span></div><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Right column: Notifications -->
    <div>
      <div class="card glass" style="position:sticky;top:80px;padding:0">
        <div class="card-header" style="padding:1.2rem;margin-bottom:0;border-bottom:1px solid var(--card-border);background:rgba(255,255,255,0.4)">
          <span class="card-title" style="display:flex;align-items:center;gap:6px">
            <span style="font-size:1.1rem">🔔</span> Thông báo gần đây
          </span>
          <form action="/notifications/read-all" method="POST" style="margin:0">
            <button type="submit" class="btn btn-ghost btn-sm" style="font-size:0.75rem;padding:0.25rem 0.6rem">Đọc hết</button>
          </form>
        </div>
        
        <div style="max-height:calc(100vh - 180px);overflow-y:auto;padding-bottom:0.5rem">
          <% if (notifications.length === 0) { %>
            <div class="empty-state" style="padding:2.5rem 1.5rem">
              <div style="font-size:2.5rem;margin-bottom:0.8rem;opacity:0.6">🔕</div>
              <p style="font-size:0.88rem;color:var(--text-dim)">Chưa có thông báo nào</p>
            </div>
          <% } else { %>
            <% notifications.slice(0,12).forEach(n => { %>
              <div class="notif-item <%= n.is_read?'':'unread' %>" data-id="<%= n.id %>" 
                   onclick="<% if(n.project_id){ %>location.href='/projects/<%= n.project_id %>'<% } %>"
                   style="border-bottom:1px solid rgba(34,197,94,0.06);padding:1rem 1.2rem">
                <div class="notif-content">
                  <div class="notif-title" style="font-size:0.88rem;color:var(--text-bright);margin-bottom:2px"><%= n.title || '📢 Thông báo' %></div>
                  <div class="notif-msg" style="font-size:0.8rem;color:var(--text-dim);line-height:1.4"><%= n.message.substring(0,85) %><%= n.message.length>85?'...':'' %></div>
                  <div class="notif-time" style="font-size:0.7rem;color:var(--text-dim);margin-top:6px;font-weight:500"><%= new Date(n.created_at).toLocaleString('vi-VN') %></div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
