<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Guest Dashboard: Public Projects -->
<div style="padding:0">
  <!-- Hero banner -->
  <div style="background:linear-gradient(135deg,var(--green-800),var(--green-600));padding:2.5rem 1.5rem 2rem;text-align:center;position:relative;overflow:hidden">
    <div style="position:absolute;top:-60px;right:-60px;width:250px;height:250px;background:rgba(255,255,255,0.06);border-radius:50%"></div>
    <div style="position:absolute;bottom:-40px;left:-40px;width:180px;height:180px;background:rgba(255,255,255,0.04);border-radius:50%"></div>
    <div style="position:relative;z-index:1">
      <div style="font-size:2.5rem;margin-bottom:0.5rem">🌐</div>
      <h1 style="color:#fff;font-size:1.8rem;font-weight:800;margin-bottom:0.5rem">Dự án công khai</h1>
      <p style="color:rgba(255,255,255,0.75);font-size:0.92rem;margin-bottom:1.5rem">Xem tổng quan các dự án được chia sẻ công khai — không cần đăng nhập</p>
      <div style="display:flex;gap:0.6rem;justify-content:center;flex-wrap:wrap">
        <a href="/auth/login" class="btn" style="background:rgba(255,255,255,0.15);border-color:rgba(255,255,255,0.3);color:#fff">🔑 Đăng nhập</a>
        <a href="/auth/register" class="btn btn-primary">✨ Đăng ký miễn phí</a>
      </div>
    </div>
  </div>

  <div class="container" style="padding-top:1.8rem;padding-bottom:4rem">
    <!-- Stats row -->
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.8rem">
      <div class="glass" style="padding:0.8rem 1.4rem;border-radius:var(--radius-lg);text-align:center;flex:1;min-width:120px">
        <div style="font-size:1.5rem;font-weight:800;color:var(--primary-dark)"><%= (locals.projects||[]).length %></div>
        <div style="font-size:0.72rem;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Dự án công khai</div>
      </div>
      <div class="glass" style="padding:0.8rem 1.4rem;border-radius:var(--radius-lg);text-align:center;flex:1;min-width:120px">
        <div style="font-size:1.5rem;font-weight:800;color:var(--primary-dark)"><%= (locals.projects||[]).reduce((s,p)=>s+parseInt(p.member_count||0),0) %></div>
        <div style="font-size:0.72rem;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Thành viên</div>
      </div>
      <div class="glass" style="padding:0.8rem 1.4rem;border-radius:var(--radius-lg);text-align:center;flex:1;min-width:120px">
        <div style="font-size:1.5rem;font-weight:800;color:var(--primary-dark)"><%= (locals.projects||[]).reduce((s,p)=>s+parseInt(p.task_count||0),0) %></div>
        <div style="font-size:0.72rem;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Nhiệm vụ</div>
      </div>
    </div>

    <!-- Projects Grid -->
    <h2 style="font-size:1rem;font-weight:700;color:var(--primary-dark);margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.08em">📁 Danh sách dự án</h2>

    <% if (!locals.projects || projects.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">🌱</div>
        <p>Chưa có dự án công khai nào.</p>
        <a href="/auth/register" class="btn btn-primary" style="margin-top:1rem">✨ Đăng ký để tạo dự án</a>
      </div>
    <% } else { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.2rem">
        <% projects.forEach(p => {
          const progress = p.task_count > 0 ? Math.round((p.done_count / p.task_count) * 100) : 0;
          const isOverdue = p.deadline && new Date(p.deadline) < new Date() && p.status !== 'completed';
        %>
          <a href="/guest/projects/<%= p.id %>" class="project-card" style="text-decoration:none">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.6rem">
              <div>
                <div style="font-weight:700;font-size:0.95rem;color:var(--text-bright);margin-bottom:2px"><%= p.name %></div>
                <div style="font-size:0.75rem;color:var(--text-dim)">👤 <%= p.owner_name %></div>
              </div>
              <% if (p.status === 'completed') { %>
                <span class="badge badge-green">✅ Xong</span>
              <% } else if (isOverdue) { %>
                <span class="badge badge-red">⚠️ Trễ</span>
              <% } else { %>
                <span class="badge badge-brown">🟢 Đang chạy</span>
              <% } %>
            </div>

            <% if (p.description) { %>
              <p style="font-size:0.82rem;color:var(--text-dim);line-height:1.5;margin-bottom:0.8rem"><%= p.description.substring(0,90) %><%= p.description.length>90?'...':'' %></p>
            <% } %>

            <!-- Progress -->
            <div style="margin-bottom:0.6rem">
              <div style="display:flex;justify-content:space-between;font-size:0.75rem;margin-bottom:4px">
                <span class="text-dim">Tiến độ</span>
                <span style="color:var(--primary-dark);font-weight:600"><%= progress %>%</span>
              </div>
              <div class="progress-wrap">
                <div class="progress-fill" data-pct="<%= progress %>" style="width:0"></div>
              </div>
            </div>

            <div class="project-card-meta">
              <span>👥 <%= p.member_count %> thành viên</span>
              <span>📋 <%= p.done_count %>/<%= p.task_count %> xong</span>
              <% if (p.deadline) { %><span>📅 <%= new Date(p.deadline).toLocaleDateString('vi-VN') %></span><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

    <!-- Join CTA -->
    <div class="glass" style="margin-top:2.5rem;padding:1.8rem;border-radius:var(--radius-xl);text-align:center">
      <div style="font-size:2rem;margin-bottom:0.5rem">🚀</div>
      <h3 style="color:var(--primary-dark);margin-bottom:0.4rem">Muốn tham gia dự án?</h3>
      <p style="color:var(--text-dim);font-size:0.88rem;margin-bottom:1rem">Đăng ký tài khoản miễn phí để tạo và quản lý dự án của riêng bạn.</p>
      <div style="display:flex;gap:0.6rem;justify-content:center;flex-wrap:wrap">
        <a href="/auth/register" class="btn btn-primary">✨ Đăng ký miễn phí</a>
        <a href="/auth/login" class="btn btn-ghost">🔑 Đã có tài khoản</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
