<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container" style="padding-top:1.5rem;padding-bottom:4rem">
  <div class="d-flex align-center justify-between mb-3">
    <h1 class="page-title" style="color:var(--yellow)">⚙️ ADMIN PANEL</h1>
  </div>
  <% if (locals.flash) { %><div class="flash flash-<%= flashType %>"><%= flashType==='success'?'✅':'⚠️' %> <%= flash %></div><% } %>

  <!-- Stats -->
  <div class="stats-grid mb-3">
    <div class="stat-card s-brown"><div class="stat-number"><%= stats.users %></div><div class="stat-label">Người dùng</div></div>
    <div class="stat-card s-pink"><div class="stat-number"><%= stats.projects %></div><div class="stat-label">Dự án</div></div>
    <div class="stat-card s-green"><div class="stat-number"><%= stats.tasks %></div><div class="stat-label">Nhiệm vụ</div></div>
    <div class="stat-card s-yellow"><div class="stat-number"><%= stats.members %></div><div class="stat-label">Thành viên nhóm</div></div>
  </div>

  <!-- Tabs for Admin Panel -->
  <div class="tabs mb-3">
    <button class="tab-btn active" onclick="switchAdminTab('users', this)">👤 Người dùng</button>
    <button class="tab-btn" onclick="switchAdminTab('projects', this)">📁 Dự án</button>
    <button class="tab-btn" onclick="switchAdminTab('database', this)">🗄️ Database</button>
  </div>

  <div>
    <!-- Users Tab -->
    <div id="tab-users" class="admin-tab" style="animation: fadeIn 0.3s ease">
      <div class="card">
        <div class="card-header d-flex align-center justify-between" style="flex-wrap:wrap;gap:1rem">
          <span class="card-title">Danh sách Người dùng</span>
          <div style="display:flex;gap:0.5rem;align-items:center">
            <input type="text" id="searchUsers" class="form-control" placeholder="🔍 Tìm kiếm user..." style="max-width:200px;font-size:0.85rem" onkeyup="filterTable('searchUsers', 'tableUsers')">
            <button class="btn btn-primary btn-sm" data-modal-open="modalUploadUser">📤 Import Excel</button>
            <button class="btn btn-brown btn-sm" data-modal-open="modalCreateUser">＋ Tạo TK</button>
          </div>
        </div>
        <div style="overflow-x:auto">
          <table class="neon-table" id="tableUsers">
            <thead><tr><th>Tên</th><th>Username</th><th>Ngày tạo</th><th>Vai trò</th><th>Gói</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
              <% users.forEach(u => { %>
                <tr>
                  <td style="color:var(--text-bright);font-weight:600"><%= u.display_name || u.username %></td>
                  <td class="text-dim">@<%= u.username %></td>
                  <td class="text-dim" style="font-size:0.85rem"><%= new Date(u.created_at).toLocaleString('vi-VN', {day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'}) %></td>
                  <td><span class="badge <%= u.role==='admin'?'badge-yellow':'badge-dim' %>"><%= u.role %></span></td>
                  <td>
                    <% if (u.role === 'admin' || u.plan === 'pro') { %>
                      <span class="badge badge-pink">⭐ PRO</span>
                    <% } else { %>
                      <span class="badge badge-dim">FREE</span>
                    <% } %>
                  </td>
                  <td><span class="badge <%= u.is_active?'badge-green':'badge-red' %>"><%= u.is_active?'✅ Hoạt động':'🚫 Khóa' %></span></td>
                  <td>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="openChangePwd('<%= u.id %>','<%= u.username %>')">🔑</button>
                    <% if (u.role !== 'admin') { %>
                      <form action="/admin/users/<%= u.id %>/toggle-plan" method="POST" style="display:inline">
                        <button type="submit" class="btn btn-ghost btn-sm" style="font-size:0.75rem"><%= u.plan==='pro' ? '⬇️ Free' : '⭐ Pro' %></button>
                      </form>
                      <form action="/admin/users/<%= u.id %>/toggle" method="POST" style="display:inline">
                        <button type="submit" class="btn btn-ghost btn-sm"><%= u.is_active?'🔒':'🔓' %></button>
                      </form>
                      <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline">
                        <button type="submit" class="btn btn-red btn-sm" data-confirm="Xóa user @<%= u.username %>?">🗑️</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Projects Tab -->
    <div id="tab-projects" class="admin-tab" style="display:none; animation: fadeIn 0.3s ease">
      <div class="card">
        <div class="card-header d-flex align-center justify-between" style="flex-wrap:wrap;gap:1rem">
          <span class="card-title">📁 Dự án gần đây</span>
          <input type="text" id="searchProjects" class="form-control" placeholder="🔍 Tìm dự án hoặc owner..." style="max-width:250px;font-size:0.85rem" onkeyup="filterTable('searchProjects', 'tableProjects')">
        </div>
        <div style="overflow-x:auto">
          <table class="neon-table" id="tableProjects">
            <thead><tr><th>Tên dự án</th><th>Owner</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thành viên</th><th>Thao tác</th></tr></thead>
            <tbody>
              <% projects.forEach(p => { %>
                <tr>
                  <td style="font-weight:600"><a href="/projects/<%= p.id %>" style="color:var(--primary);text-decoration:none"><%= p.name %></a></td>
                  <td class="text-dim"><%= p.owner_name || '-' %></td>
                  <td class="text-dim" style="font-size:0.85rem"><%= new Date(p.created_at).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <span class="badge <%= p.status==='completed'?'badge-green':(p.status==='archived'?'badge-dim':'badge-brown') %>">
                      <%= p.status %>
                    </span>
                  </td>
                  <td><span class="badge badge-dim">👥 <%= p.member_count %></span></td>
                  <td>
                    <form action="/admin/projects/<%= p.id %>/delete" method="POST" style="display:inline">
                      <button type="submit" class="btn btn-red btn-sm" data-confirm="Xóa dự án '<%= p.name %>'?">🗑️</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Database Tab -->
    <div id="tab-database" class="admin-tab" style="display:none; animation: fadeIn 0.3s ease">
      <div class="card">
        <div class="card-header">
          <span class="card-title">🗄️ Quản lý Database</span>
        </div>
        <div class="card-body" style="padding: 1.5rem;">
          <p style="margin-bottom: 1.5rem; color: var(--text-dim);">Tại đây bạn có thể sao lưu (tải về) hoặc khôi phục (tải lên) toàn bộ dữ liệu của hệ thống.</p>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/admin/database/export" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 1.5rem; font-weight: 600;">
              ⬇️ Tải về Full Database
            </a>
            <button class="btn btn-brown" data-modal-open="modalImportDB" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 1.5rem; font-weight: 600;">
              📤 Upload Database
            </button>
          </div>
          
          <div style="margin-top: 2rem; background: rgba(255,0,0,0.05); border: 1px solid rgba(255,0,0,0.2); padding: 1.25rem; border-radius: 8px;">
            <h4 style="color: var(--red); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">⚠️ CẢNH BÁO KHI IMPORT</h4>
            <ul style="color: var(--text-dim); margin-left: 1.5rem; line-height: 1.6; font-size: 0.95rem;">
              <li>Quá trình Import sẽ <strong>XÓA SẠCH</strong> toàn bộ dữ liệu hiện tại và thay thế bằng dữ liệu từ file JSON tải lên.</li>
              <li>Hệ thống sử dụng cơ chế <strong>Database Transaction</strong>: Nếu gặp bất kỳ lỗi gì giữa chừng, toàn bộ thay đổi sẽ bị hủy bỏ (Rollback), đảm bảo an toàn và không bao giờ mất dữ liệu do lỗi.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Create User -->
<div class="modal-overlay" id="modalCreateUser">
  <div class="modal">
    <div class="modal-header">
      <h3 class="neon-text-brown" style="font-size:1rem">👤 Tạo tài khoản mới</h3>
      <button class="modal-close" data-modal-close="modalCreateUser">✕</button>
    </div>
    <form action="/admin/users/create" method="POST">
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label">Username *</label>
          <input type="text" name="username" class="form-control" required/>
        </div>
        <div class="form-group">
          <label class="form-label">Tên hiển thị *</label>
          <input type="text" name="display_name" class="form-control" required/>
        </div>
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label">Mật khẩu *</label>
          <input type="password" name="password" class="form-control" required/>
        </div>
        <div class="form-group">
          <label class="form-label">Vai trò</label>
          <select name="role" class="form-control">
            <option value="user">User</option>
            <option value="admin">Admin</option>
          </select>
        </div>
      </div>
      <p style="font-size:0.8rem;color:var(--text-dim);margin-bottom:0.8rem">
        💡 Tài khoản mới đăng ký mặc định gói <strong>FREE</strong>. Admin có thể cấp Pro ở cột "Gói" bên trên.
      </p>
      <div style="display:flex;gap:0.5rem;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" data-modal-close="modalCreateUser">Hủy</button>
        <button type="submit" class="btn btn-brown">＋ Tạo</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Đổi mật khẩu tài khoản (Admin) -->
<div class="modal-overlay" id="modalChangePwd">
  <div class="modal">
    <div class="modal-header">
      <h3 class="neon-text-brown" style="font-size:1rem">🔑 Đổi mật khẩu — <span id="pwdModalUsername"></span></h3>
      <button class="modal-close" onclick="document.getElementById('modalChangePwd').classList.remove('open')">✕</button>
    </div>
    <form id="changePwdForm" method="POST">
      <div class="form-group">
        <label class="form-label">Mật khẩu mới *</label>
        <div style="position:relative">
          <input type="password" name="new_password" id="adminNewPass" class="form-control" required minlength="6" placeholder="Tối thiểu 6 ký tự" style="padding-right:2.8rem"/>
          <button type="button" onclick="toggleAdminPwd('adminNewPass',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:1.1rem">👁</button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Xác nhận mật khẩu mới *</label>
        <div style="position:relative">
          <input type="password" name="confirm_new_password" id="adminCfmPass" class="form-control" required placeholder="Nhập lại mật khẩu" style="padding-right:2.8rem"/>
          <button type="button" onclick="toggleAdminPwd('adminCfmPass',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:1.1rem">👁</button>
        </div>
        <div id="adminMatchMsg" style="margin-top:4px;font-size:0.78rem"></div>
      </div>
      <div style="display:flex;gap:0.5rem;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalChangePwd').classList.remove('open')">Hủy</button>
        <button type="submit" class="btn btn-brown">🔐 Lưu mật khẩu</button>
      </div>
    </form>
  </div>
</div>
<!-- Modal: Upload User -->
<div class="modal-overlay" id="modalUploadUser">
  <div class="modal">
    <div class="modal-header">
      <h3 class="neon-text-primary" style="font-size:1rem">📤 Import Excel Thành viên</h3>
      <button class="modal-close" data-modal-close="modalUploadUser">✕</button>
    </div>
    <form action="/admin/users/upload" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:1rem;font-size:0.9rem;color:var(--text-dim);line-height:1.5">
        <p>1. <a href="/admin/users/upload-template" style="color:var(--primary);text-decoration:underline">Tải file Excel mẫu</a></p>
        <p>2. Điền thông tin thành viên (STT, Họ tên, Username, Password, Mã nhóm, Email). <strong>Mật khẩu là bắt buộc</strong>.</p>
        <p>3. Chọn file và bấm Tải lên.</p>
      </div>
      <div class="form-group">
        <label class="form-label">Chọn file Excel (.xlsx) *</label>
        <input type="file" name="file" accept=".xlsx" class="form-control" required style="padding:0.5rem;background:rgba(255,255,255,0.05)"/>
      </div>
      <div style="display:flex;gap:0.5rem;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" data-modal-close="modalUploadUser">Hủy</button>
        <button type="submit" class="btn btn-primary">📤 Tải lên</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Import DB -->
<div class="modal-overlay" id="modalImportDB">
  <div class="modal">
    <div class="modal-header">
      <h3 class="neon-text-primary" style="font-size:1rem">📤 Upload & Restore Database</h3>
      <button class="modal-close" data-modal-close="modalImportDB">✕</button>
    </div>
    <form action="/admin/database/import" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:1rem;font-size:0.9rem;color:var(--text-dim);line-height:1.5">
        <p>Chọn file backup <code>.json</code> để khôi phục dữ liệu toàn hệ thống.</p>
      </div>
      <div class="form-group">
        <label class="form-label">Chọn file JSON *</label>
        <input type="file" name="file" accept=".json" class="form-control" required style="padding:0.5rem;background:rgba(255,255,255,0.05)"/>
      </div>
      <div style="display:flex;gap:0.5rem;justify-content:flex-end; margin-top: 1rem;">
        <button type="button" class="btn btn-ghost" data-modal-close="modalImportDB">Hủy</button>
        <button type="submit" class="btn btn-red" onclick="return confirm('Bạn có CHẮC CHẮN muốn import và XÓA TOÀN BỘ dữ liệu hiện tại không?')">⚠️ Khôi phục ngay</button>
      </div>
    </form>
  </div>
</div>

<% if (locals.showUploadResult) { %>
<!-- Modal: Kết quả Upload -->
<div class="modal-overlay open" id="modalUploadResult">
  <div class="modal" style="max-width:600px">
    <div class="modal-header">
      <h3 class="neon-text-<%= flashType === 'warning' ? 'yellow' : 'green' %>" style="font-size:1rem">
        <%= flashType === 'warning' ? '⚠️ Kết quả Import (Có lỗi)' : '✅ Kết quả Import (Thành công)' %>
      </h3>
      <button class="modal-close" onclick="document.getElementById('modalUploadResult').classList.remove('open')">✕</button>
    </div>
    <div style="margin-bottom:1rem;font-size:0.95rem">
      <p style="margin-bottom:1rem;font-weight:bold"><%= flash %></p>
      <% if (locals.uploadErrors && uploadErrors.length > 0) { %>
        <p style="color:var(--text-dim);margin-bottom:0.5rem">Chi tiết lỗi:</p>
        <div style="background:rgba(255,0,0,0.05);border:1px solid rgba(255,0,0,0.1);padding:0.8rem;border-radius:8px;max-height:200px;overflow-y:auto;font-size:0.85rem;color:var(--red);line-height:1.5">
          <% uploadErrors.forEach(err => { %>
            <div>• <%= err %></div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <div style="display:flex;justify-content:flex-end">
      <button class="btn btn-ghost" onclick="document.getElementById('modalUploadResult').classList.remove('open')">Đóng</button>
    </div>
  </div>
</div>
<% } %>

<script>
function openChangePwd(uid, uname) {
  document.getElementById('pwdModalUsername').textContent = '@' + uname;
  document.getElementById('changePwdForm').action = '/admin/users/' + uid + '/change-password';
  document.getElementById('adminNewPass').value = '';
  document.getElementById('adminCfmPass').value = '';
  document.getElementById('adminMatchMsg').textContent = '';
  document.getElementById('modalChangePwd').classList.add('open');
}
function toggleAdminPwd(id, btn) {
  const el = document.getElementById(id);
  el.type = el.type === 'password' ? 'text' : 'password';
  btn.textContent = el.type === 'password' ? '👁' : '🙈';
}
document.getElementById('adminCfmPass').addEventListener('input', function() {
  const msg = document.getElementById('adminMatchMsg');
  const newp = document.getElementById('adminNewPass').value;
  if (!this.value) { msg.textContent = ''; return; }
  if (this.value === newp) { msg.textContent = '✅ Khớp'; msg.style.color = 'var(--green)'; }
  else { msg.textContent = '❌ Chưa khớp'; msg.style.color = 'var(--red)'; }
});

function switchAdminTab(tabId, btn) {
  // Update buttons
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  // Update content
  document.querySelectorAll('.admin-tab').forEach(t => t.style.display = 'none');
  document.getElementById('tab-' + tabId).style.display = 'block';
}

function filterTable(inputId, tableId) {
  const input = document.getElementById(inputId);
  const filter = input.value.toLowerCase();
  const table = document.getElementById(tableId);
  const tr = table.getElementsByTagName("tr");

  for (let i = 1; i < tr.length; i++) { // Skip header row
    const row = tr[i];
    const text = row.textContent || row.innerText;
    if (text.toLowerCase().indexOf(filter) > -1) {
      row.style.display = "";
    } else {
      row.style.display = "none";
    }
  }
}
</script>

<%- include('../partials/footer') %>
