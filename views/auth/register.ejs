<%- include('../partials/header') %>

<style>
.auth-split {
  display: flex;
  min-height: 100vh;
  background: var(--bg);
  width: 100%;
}
.auth-left {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  position: relative;
  z-index: 1;
}
.auth-left-inner {
  width: 100%;
  max-width: 480px;
}
.auth-right {
  flex: 1.2;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 3rem;
  position: relative;
  overflow: hidden;
}
.auth-right::before {
  content: "";
  position: absolute;
  top: -10%; right: -10%;
  width: 60vw; height: 60vw;
  background: radial-gradient(circle, rgba(14, 165, 233, 0.15) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}
.auth-right::after {
  content: "";
  position: absolute;
  bottom: -15%; left: -10%;
  width: 50vw; height: 50vw;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.1) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}
.auth-hero-text {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 500px;
}
.auth-hero-text h2 {
  font-size: 2.8rem;
  color: #fff;
  margin-bottom: 1.2rem;
  line-height: 1.15;
  font-weight: 800;
}
.auth-hero-text p {
  font-size: 1.15rem;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
}
.auth-glass-panel {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-xl);
  padding: 2rem;
  margin-top: 2.5rem;
  box-shadow: 0 12px 32px rgba(0,0,0,0.25);
  text-align: left;
}
.feature-item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16px;
}
.feature-item:not(:last-child) {
  margin-bottom: 1.5rem;
}
.feature-icon {
  width: 48px; height: 48px;
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem;
  background: rgba(255,255,255,0.1);
  box-shadow: inset 0 2px 10px rgba(255,255,255,0.05);
  flex-shrink: 0;
}
.feature-text {
  text-align: left;
}
.feature-text h4 {
  color: #fff;
  margin: 0 0 0.2rem 0;
  font-size: 1.05rem;
}
.feature-text p {
  margin: 0;
  font-size: 0.9rem;
  color: rgba(255,255,255,0.6);
}
@media (max-width: 900px) {
  .auth-right { display: none; }
}
</style>

<div class="auth-split">
  <div class="auth-left">
    <div class="auth-left-inner fade-in">
      <!-- Logo -->
      <div class="auth-logo" style="text-align: left; margin-bottom: 2rem;">
        <div class="d-flex align-center gap-2 mb-2">
          <div class="auth-logo-icon" style="margin: 0; width: 42px; height: 42px; font-size: 1.3rem; border-radius: 10px; background: linear-gradient(135deg, #0f172a, #334155);">⚡</div>
          <div class="auth-logo-text" style="font-size: 1.6rem;">19A-Teamly</div>
        </div>
        <p style="color:var(--text-dim);font-size:1rem;margin-top:0.5rem">Tạo tài khoản mới để bắt đầu.</p>
      </div>

      <% if (flash) { %>
        <div class="flash flash-<%= flashType %>" style="border-radius: 10px;">
          <%= flashType === 'success' ? '✅' : '⚠️' %> <%= flash %>
        </div>
      <% } %>

      <form action="/auth/register" method="POST">
        <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 0.85rem;">Tên đăng nhập *</label>
            <input type="text" name="username" class="form-control" placeholder="username" required style="padding: 0.85rem 1rem; font-size: 0.95rem; border-radius: 10px;"/>
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 0.85rem;">Tên hiển thị *</label>
            <input type="text" name="display_name" class="form-control" placeholder="Tên của bạn" required style="padding: 0.85rem 1rem; font-size: 0.95rem; border-radius: 10px;"/>
          </div>
        </div>
        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" style="font-size: 0.85rem;">Email (tùy chọn)</label>
          <input type="email" name="email" class="form-control" placeholder="email@example.com" style="padding: 0.85rem 1rem; font-size: 0.95rem; border-radius: 10px;"/>
        </div>
        <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 0.85rem;">Mật khẩu *</label>
            <input type="password" name="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required style="padding: 0.85rem 1rem; font-size: 0.95rem; border-radius: 10px;"/>
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" style="font-size: 0.85rem;">Xác nhận MK *</label>
            <input type="password" name="confirm_password" class="form-control" placeholder="Nhập lại" required style="padding: 0.85rem 1rem; font-size: 0.95rem; border-radius: 10px;"/>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block" style="padding: 0.9rem; font-size: 1.05rem; border-radius: 10px; background: linear-gradient(135deg, #0ea5e9, #0284c7); box-shadow: 0 4px 14px rgba(14,165,233,0.35);">
          ✨ Tạo tài khoản
        </button>
      </form>

      <div style="text-align:center;margin-top:1.5rem;color:var(--text-dim);font-size:0.95rem">
        Đã có tài khoản? <a href="/auth/login" style="color:#0ea5e9;font-weight:700">Đăng nhập ngay</a>
      </div>
      <div style="margin-top: 1.5rem; text-align: center;">
        <a href="/" class="btn btn-ghost" style="border-radius: 10px; padding: 0.7rem 1.5rem;">👀 Tiếp tục như Khách</a>
      </div>
    </div>
  </div>
  
  <div class="auth-right">
    <div class="auth-hero-text fade-in">
      <h2>Bắt đầu hành trình<br>của bạn ngay hôm nay</h2>
      <p>Tham gia cùng hàng ngàn người dùng khác để trải nghiệm công cụ quản lý tuyệt vời.</p>
      
      <div class="auth-glass-panel">
        <div class="feature-item">
          <div class="feature-icon" style="color: #60a5fa;">💡</div>
          <div class="feature-text">
            <h4>Ý tưởng không giới hạn</h4>
            <p>Biến mọi ý tưởng thành hiện thực với công cụ hỗ trợ thông minh</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon" style="color: #a78bfa;">🔒</div>
          <div class="feature-text">
            <h4>Bảo mật tuyệt đối</h4>
            <p>Dữ liệu của bạn luôn được mã hóa và bảo vệ an toàn</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon" style="color: #fbbf24;">📈</div>
          <div class="feature-text">
            <h4>Theo dõi tiến độ</h4>
            <p>Cập nhật liên tục để không bỏ lỡ bất kỳ cột mốc nào</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mobile-bottom-nav" style="display:none"></div>
</body>
</html>
