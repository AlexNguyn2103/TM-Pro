<%- include('../partials/header') %>

<style>
.auth-split {
  display: flex;
  min-height: 100vh;
  background: var(--bg);
  width: 100%;
}
.auth-left {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  position: relative;
  z-index: 1;
}
.auth-left-inner {
  width: 100%;
  max-width: 420px;
}
.auth-right {
  flex: 1.2;
  background: linear-gradient(135deg, var(--green-900), var(--green-700));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 3rem;
  position: relative;
  overflow: hidden;
}
.auth-right::before {
  content: "";
  position: absolute;
  top: -10%; right: -10%;
  width: 60vw; height: 60vw;
  background: radial-gradient(circle, rgba(74, 222, 128, 0.15) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}
.auth-right::after {
  content: "";
  position: absolute;
  bottom: -15%; left: -10%;
  width: 50vw; height: 50vw;
  background: radial-gradient(circle, rgba(14, 165, 233, 0.1) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}
.auth-hero-text {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 500px;
}
.auth-hero-text h2 {
  font-size: 2.8rem;
  color: #fff;
  margin-bottom: 1.2rem;
  line-height: 1.15;
  font-weight: 800;
}
.auth-hero-text p {
  font-size: 1.15rem;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
}
.auth-glass-panel {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-xl);
  padding: 2rem;
  margin-top: 2.5rem;
  box-shadow: 0 12px 32px rgba(0,0,0,0.25);
  text-align: left;
}
.feature-item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16px;
}
.feature-item:not(:last-child) {
  margin-bottom: 1.5rem;
}
.feature-icon {
  width: 48px; height: 48px;
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem;
  background: rgba(255,255,255,0.15);
  box-shadow: inset 0 2px 10px rgba(255,255,255,0.1);
  flex-shrink: 0;
}
.feature-text {
  text-align: left;
}
.feature-text h4 {
  color: #fff;
  margin: 0 0 0.2rem 0;
  font-size: 1.05rem;
}
.feature-text p {
  margin: 0;
  font-size: 0.9rem;
  color: rgba(255,255,255,0.7);
}
@media (max-width: 900px) {
  .auth-right { display: none; }
}
</style>

<div class="auth-split">
  <div class="auth-left">
    <div class="auth-left-inner fade-in">
      <!-- Logo -->
      <div class="auth-logo" style="text-align: left; margin-bottom: 2.5rem;">
        <div class="d-flex align-center gap-2 mb-2">
          <div class="auth-logo-icon" style="margin: 0; width: 50px; height: 50px; font-size: 1.5rem; border-radius: 12px;">🌿</div>
          <div class="auth-logo-text" style="font-size: 1.8rem;">19A-Teamly</div>
        </div>
        <p style="color:var(--text-dim);font-size:1rem;margin-top:0.5rem">Chào mừng trở lại! Vui lòng đăng nhập.</p>
      </div>

      <!-- Guest quick access banner -->
      <a href="/guest" class="guest-choice-banner" style="border-radius: 12px; padding: 1.2rem;">
        <div class="gcb-icon" style="background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">👀</div>
        <div class="gcb-text">
          <strong style="font-size: 0.95rem;">Xem với tư cách Khách</strong>
          <span style="font-size: 0.8rem;">Xem ngay dự án công khai, không cần tài khoản</span>
        </div>
        <div class="gcb-arrow">→</div>
      </a>

      <div class="divider-or" style="margin: 2rem 0;"><span>hoặc đăng nhập</span></div>

      <% if (flash) { %>
        <div class="flash flash-<%= flashType %>" style="border-radius: 10px;">
          <%= flashType === 'success' ? '✅' : '⚠️' %> <%= flash %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST">
        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label class="form-label" style="font-size: 0.85rem;">Tên đăng nhập</label>
          <input type="text" name="username" class="form-control" placeholder="Nhập username..." required autocomplete="username" style="padding: 0.85rem 1rem; font-size: 1rem; border-radius: 10px;"/>
        </div>
        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label class="form-label" style="font-size: 0.85rem;">Mật khẩu</label>
          <input type="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password" style="padding: 0.85rem 1rem; font-size: 1rem; border-radius: 10px;"/>
        </div>
        <button type="submit" class="btn btn-primary btn-block" style="padding: 0.9rem; font-size: 1.05rem; border-radius: 10px; margin-top: 0.5rem;">
          🚀 Đăng nhập
        </button>
      </form>

      <div style="text-align:center;margin-top:2rem;color:var(--text-dim);font-size:0.95rem">
        Chưa có tài khoản? <a href="/auth/register" style="color:var(--primary-dark);font-weight:700">Đăng ký ngay →</a>
      </div>
    </div>
  </div>
  
  <div class="auth-right">
    <div class="auth-hero-text fade-in">
      <h2>Quản lý dự án<br>thông minh & hiệu quả</h2>
      <p>Cùng 19A-Teamly tối ưu hóa quy trình làm việc, theo dõi tiến độ và cộng tác dễ dàng hơn bao giờ hết.</p>
      
      <div class="auth-glass-panel">
        <div class="feature-item">
          <div class="feature-icon" style="color: #4ade80;">✨</div>
          <div class="feature-text">
            <h4>Giao diện hiện đại</h4>
            <p>Trải nghiệm người dùng tuyệt vời với thiết kế trực quan</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon" style="color: #38bdf8;">🚀</div>
          <div class="feature-text">
            <h4>Hiệu suất vượt trội</h4>
            <p>Xử lý công việc mượt mà và nhanh chóng trong nháy mắt</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon" style="color: #f472b6;">🤝</div>
          <div class="feature-text">
            <h4>Cộng tác dễ dàng</h4>
            <p>Kết nối và làm việc nhóm không giới hạn</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mobile-bottom-nav" style="display:none"></div>
</body>
</html>
