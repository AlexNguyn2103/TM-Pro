<!DOCTYPE html>
<html lang="vi" data-theme="<%= locals.theme || 'light' %>">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content="19A-Teamly – Nền tảng quản lý nhóm hiệu quả, hiện đại"/>
  <title><%= title %> | 19A-Teamly</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%2322c55e'/><text y='24' x='4' font-size='22'>🌿</text></svg>"/>

  <%# Google Fonts – Inter & Be Vietnam Pro %>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"
        media="print" onload="this.media='all'"/>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"/>
  </noscript>

  <%# Main CSS %>
  <link rel="stylesheet" href="/css/neon.css?v=3"/>

  <%# Chart.js for stats tabs %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <%# Custom accent color for Pro users %>
  <% if (locals.currentUser && currentUser.isPro && currentUser.accentColor) { %>
  <style>:root { --primary: <%= currentUser.accentColor %>; --primary-dark: <%= currentUser.accentColor %>; }</style>
  <% } %>
</head>
